# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env не попадает в git — токен никому не показывайте.

# Токен бота от @BotFather (обязательно)
BOT_TOKEN=

# Язык перевода по умолчанию (ru, en, ar, tr, uz, kk, ky, tg, az, fr, …)
DEFAULT_LANGUAGE=ru

# Во сколько присылать «Хадис дня» подписчикам и часовой пояс
DAILY_TIME=08:00
TIMEZONE=Europe/Moscow

# Необязательно: канал, куда бот каждый день публикует «Хадис дня».
# Добавьте бота в канал администратором и укажите @username канала или его числовой id.
CHANNEL_ID=

# Ссылка на сайт энциклопедии (раздел «О проекте»)
SITE_URL=https://sarhaan.com/hadeeth/ru/

# Ссылка «На сайте» под каждым хадисом: {lang} — язык, {id} — номер хадиса
HADITH_URL_TEMPLATE=https://sarhaan.com/hadeeth/{lang}/{id}/

# Папка для базы пользователей и кеша
# DATA_DIR=./data
